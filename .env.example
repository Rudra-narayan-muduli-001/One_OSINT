# one-osint API keys
# Copy this file to `.env` (same folder) and fill in the keys you have.
# Keys you leave empty simply disable the related engines - everything else works.
#
# Where to get each key:
#   HIBP                https://haveibeenpwned.com/API/Key        ($3.50/mo)
#   EMAILREP            https://emailrep.io/key                    (free tier)
#   BREACHDIRECTORY     https://rapidapi.com/ (search BreachDirectory)
#   INTELX              https://intelx.io                          (free trial)
#   SHODAN              https://account.shodan.io                  ($49 one-time or free limited)
#   NUMVERIFY           https://numverify.com                      (100 free/mo)
#   GOOGLE_CSE + CX     https://programmablesearchengine.google.com (100 free/day)
#   HUDSONROCK          https://cavalier.hudsonrock.com            (free)

# --- breach data ---
HIBP_API_KEY=
BREACHDIRECTORY_API_KEY=
INTELX_API_KEY=
HUDSONROCK_API_KEY=

# --- email ---
EMAILREP_API_KEY=

# --- ip / infrastructure ---
SHODAN_API_KEY=

# --- phone ---
NUMVERIFY_API_KEY=

# --- google engines ---
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_GEOLOCATION_API_KEY=

# --- optional extras ---
GITHUB_TOKEN=
CERTSPOTTER_API_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
HUNTER_IO_API_KEY=
RAPIDAPI_KEY=
